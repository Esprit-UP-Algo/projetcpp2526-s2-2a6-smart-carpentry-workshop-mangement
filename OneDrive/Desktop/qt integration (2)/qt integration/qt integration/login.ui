  <property name="styleSheet">
   <string notr="true">/* --- Fond de la fenêtre de Login --- */
#LoginWindow, QWidget {
    background-color: #F5EBD7; /* Même beige que la MainWindow */
}

/* --- Style des Textes (EMAIL, PASSWORD, etc.) --- */
QLabel {
    color: #3E2723; /* Marron très foncé */
    font-weight: bold;
    font-size: 12px;
    background: transparent;
}

/* --- Style des champs de saisie (Email et Mot de passe) --- */
QLineEdit {
    background-color: #FFFFFF; /* Blanc pur */
    border: 2px solid #A1887F; /* Bordure marron clair */
    border-radius: 8px;
    padding: 8px;
    color: #3E2723;
    selection-background-color: #D7CCC8;
}

/* Effet quand on clique dans le champ */
QLineEdit:focus {
    border: 2px solid #5D4037; /* Bordure plus foncée au focus */
}

/* --- Le bouton SIGN IN --- */
QPushButton {
    background-color: #5D4037; /* Marron chocolat */
    color: white;
    border-radius: 10px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 13px;
    min-width: 100px;
}

/* Effet de survol (hover) */
QPushButton:hover {
    background-color: #795548; /* Marron un peu plus clair au survol */
}

/* Effet quand on clique sur le bouton */
QPushButton:pressed {
    background-color: #3E2723;
}

/* --- Style spécifique pour le cadre du Logo (si nécessaire) --- */
/* Si ton label de logo a un cadre que tu veux styliser */
QLabel#label_logo {
    border: none;
    background: transparent;
}</string>
