  <property name="styleSheet">
   <string notr="true">
/* ============================================================
   CSS GLOBAL UNIFIE - WoodPilot
   ============================================================ */

QMainWindow, QWidget#centralwidget {
    background-color: #EDE0C8;
}

QStackedWidget {
    background-color: transparent;
}

QTabWidget::pane {
    border: 1px solid #8D6E63;
    background-color: #EDE0C8;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #C8B89A;
    color: #3E2000;
    padding: 10px 25px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 3px;
    font-weight: bold;
    font-size: 12px;
}

QTabBar::tab:selected {
    background-color: #7F4129;
    color: #FFFFFF;
}

QTabBar::tab:hover:!selected {
    background-color: #B8A080;
}

QLabel {
    color: #2E1A00;
    font-weight: bold;
    font-size: 12px;
    background-color: transparent;
}

QGroupBox {
    background-color: #FDFAF4;
    border: 2px solid #B8956A;
    border-radius: 10px;
    margin-top: 18px;
    font-weight: bold;
    font-size: 13px;
    color: #4A2800;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    color: #4A2800;
    background-color: transparent;
}

QLineEdit, QDateEdit, QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #C0A882;
    border-radius: 4px;
    padding: 5px 8px;
    color: #2E1A00;
    font-size: 12px;
    selection-background-color: #8D6E63;
}

QLineEdit:focus, QDateEdit:focus {
    border: 2px solid #7F4129;
    background-color: #FFFEF8;
}

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #C0A882;
    border-radius: 4px;
    padding: 5px 8px;
    color: #2E1A00;
    font-size: 12px;
}

QComboBox::drop-down {
    border: none;
    background-color: #D4B896;
    width: 24px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #C0A882;
    color: #2E1A00;
    selection-background-color: #7F4129;
    selection-color: white;
}

QPushButton {
    background-color: #7F4129;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 9px 18px;
    font-weight: bold;
    font-size: 12px;
    min-height: 30px;
}

QPushButton:hover {
    background-color: #9C5233;
}

QPushButton:pressed {
    background-color: #5C2E1A;
}

QTableView, QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #B8956A;
    border-radius: 6px;
    gridline-color: #E8D5BA;
    font-size: 12px;
    color: #2E1A00;
    alternate-background-color: #FAF4EA;
    selection-background-color: transparent;
    selection-color: #2E1A00;
}

QTableView::item:selected,
QTableWidget::item:selected {
    background-color: #D4851A;
    color: #FFFFFF;
    font-weight: bold;
    border-left: 3px solid #7F4129;
}

QTableView::item:hover,
QTableWidget::item:hover {
    background-color: #F0C080;
    color: #2E1A00;
}

QTableView::item:selected:hover,
QTableWidget::item:selected:hover {
    background-color: #C07010;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #7F4129;
    color: #FFFFFF;
    padding: 7px 5px;
    font-weight: bold;
    font-size: 12px;
    border: 1px solid #5C2E1A;
}

QTextEdit {
    background-color: #FDFAF4;
    border: 2px solid #B8956A;
    border-radius: 8px;
    padding: 8px;
    color: #2E1A00;
    font-size: 11pt;
}

QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #B8956A;
    border-radius: 6px;
    color: #2E1A00;
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #E8D5BA;
}

QListWidget::item:selected {
    background-color: #7F4129;
    color: #FFFFFF;
}

QProgressBar {
    border: 2px solid #8D6E63;
    border-radius: 5px;
    text-align: center;
    background-color: #F0EBE0;
}

QProgressBar::chunk {
    background-color: #7F4129;
    border-radius: 3px;
}

QScrollBar:vertical {
    background: #EDE0C8;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #7F4129;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

QScrollBar:horizontal {
    background: #EDE0C8;
    height: 10px;
    border-radius: 5px;
}


QScrollBar::handle:horizontal {
    background: #7F4129;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }

QMenuBar {
    background-color: #5C2E1A;
    color: #FFFFFF;
}

QMenuBar::item:selected {
    background-color: #7F4129;
}

QStatusBar {
    background-color: #5C2E1A;
    color: #FFFFFF;
    font-size: 11px;
}
   </string>
