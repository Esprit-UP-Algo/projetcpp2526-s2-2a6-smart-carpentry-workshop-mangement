/* LA FENÊTRE DU CALENDRIER */
QCalendarWidget QWidget {
    background-color: #FAF3E0;
    alternate-background-color: #F2E8D5; /* Lignes alternées */
}

/* FORCE LA COULEUR DES MOIS ET DES ANNÉES (Ce qui n'était pas clair) */
QCalendarWidget QMenu {
    background-color: #FAF3E0;
    color: #5D3A2E; /* Texte du menu des mois en Marron */
    selection-background-color: #8B4513;
}

/* La barre de navigation du haut (Mois/Année) */
QCalendarWidget QNavigationBar {
    background-color: #5D3A2E;
}

/* Les chiffres et les jours */
QCalendarWidget QAbstractItemView {
    color: #5D3A2E; /* Chiffres en marron */
    selection-background-color: #8B4513;
    selection-color: white;
}

/* Les boutons Suivant/Précédent */
QCalendarWidget QToolButton {
    color: white;
    background-color: #5D3A2E;
    border-radius: 3px;
}</string>
