      <widget class="QWidget" name="tab_metier">
       <property name="styleSheet">
        <string notr="true">QWidget {
    background-color: #FDF8F3;
    font-family: Arial;
    font-size: 12px;
    color: #3D1F0A;
}
QGroupBox {
    background-color: #FDF8F3;
    border: 1px solid #D4A574;
    border-radius: 10px;
    margin-top: 6px;
    font-size: 11px;
    font-weight: bold;
    color: #6B3A1F;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 10px;
    background-color: #6B3A1F;
    color: #FFF8F0;
    border-radius: 6px;
}
QLabel {
    color: #6B3A1F;
    font-weight: bold;
    font-size: 11px;
}
QComboBox {
    background-color: #FFF8F0;
    border: 1px solid #C4956A;
    border-radius: 6px;
    padding: 6px 10px;
    color: #3D1F0A;
    font-weight: 500;
    min-height: 28px;
}
QComboBox:hover {
    border: 1px solid #8B4513;
}
QComboBox:focus {
    border: 2px solid #6B3A1F;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #FFF8F0;
    border: 1px solid #C4956A;
    selection-background-color: #D4A574;
    selection-color: #3D1F0A;
}
QLineEdit {
    background-color: #FFF8F0;
    border: 1px solid #C4956A;
    border-radius: 6px;
    padding: 6px 10px;
    color: #3D1F0A;
    min-height: 28px;
}
QLineEdit:hover {
    border: 1px solid #8B4513;
}
QLineEdit:focus {
    border: 2px solid #6B3A1F;
    background-color: #FFFAF5;
}
QPushButton#btn_affecter {
    background-color: #6B3A1F;
    color: #FFF8F0;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}
QPushButton#btn_affecter:hover {
    background-color: #8B4513;
}
QPushButton#btn_affecter:pressed {
    background-color: #4A2510;
}
QPushButton#btn_retirer {
    background-color: #FDF0EE;
    color: #C0392B;
    border: 1px solid #C0392B;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}
QPushButton#btn_retirer:hover {
    background-color: #FADBD8;
}
QPushButton#btn_changer_statut {
    background-color: #2E7D32;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}
QPushButton#btn_changer_statut:hover {
    background-color: #388E3C;
}
QPushButton#btn_changer_statut:pressed {
    background-color: #1B5E20;
}
QTableView {
    background-color: #FDF8F3;
    border: 1px solid #D4A574;
    border-radius: 8px;
    gridline-color: #EDD9C0;
    selection-background-color: #D4A574;
    selection-color: #3D1F0A;
    font-size: 12px;
    alternate-background-color: #FDF5ED;
}
QTableView::item {
    padding: 6px 10px;
    border-bottom: 1px solid #EDD9C0;
    color: #3D1F0A;
}
QTableView::item:selected {
    background-color: #D4A574;
    color: #3D1F0A;
}
QTableView::item:hover {
    background-color: #F5E6D3;
}
QHeaderView::section {
    background-color: #F5E6D3;
    color: #5D3A1A;
    font-weight: bold;
    font-size: 10px;
    padding: 8px 10px;
    border: none;
    border-bottom: 2px solid #C4956A;
    border-right: 1px solid #D4A574;
}
QScrollBar:vertical {
    background: #FDF8F3;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #C4956A;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #8B4513;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QLabel#lbl_total_etapes {
    font-size: 20px;
    font-weight: bold;
    color: #6B3A1F;
}
QLabel#lbl_planifiees {
    font-size: 20px;
    font-weight: bold;
    color: #185FA5;
}
QLabel#lbl_en_cours {
    font-size: 20px;
    font-weight: bold;
    color: #854F0B;
}
QLabel#lbl_terminees {
    font-size: 20px;
    font-weight: bold;
    color: #3B6D11;
}</string>
